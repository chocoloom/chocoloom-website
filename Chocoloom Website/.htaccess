# Chocoloom - Clean URLs Configuration
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. 301 Redirect direct requests for index.html or order.html to clean root /
RewriteCond %{THE_REQUEST} \s/(order|index)\.html[?\s] [NC]
RewriteRule ^(order|index)\.html$ / [R=301,L]

# 2. 301 Redirect any direct request for *.html to clean URL (e.g. /login.html -> /login)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. Allow /order to serve order.html internally without exposing the extension
RewriteRule ^order/?$ order.html [L]

# 4. Clean URLs for all pages (e.g. /login, /landing, /chocowallet, /uni-chocoloom)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
</IfModule>
